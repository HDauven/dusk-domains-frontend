# Copy to .env.mainnet.local and replace the contract and driver placeholders.
VITE_DUSK_DOMAINS_CHAIN_ID=dusk:1
VITE_DUSK_DOMAINS_NODE_URL=https://nodes.dusk.network
VITE_DUSK_DOMAINS_INDEXER_URL=/api
VITE_DUSK_DOMAINS_SITE_URL=https://dusk.domains
VITE_DUSK_DOMAINS_OTHER_NETWORK_URL=https://testnet.dusk.domains
VITE_DUSK_DOMAINS_NOINDEX=false

# IDs and hash-versioned drivers must match the contracts deployed on this network.
VITE_DUSK_DOMAINS_ROUTER_CONTRACT_ID=<0x-router-contract-id>
VITE_DUSK_DOMAINS_CORE_CONTRACT_ID=<0x-core-contract-id>
VITE_DUSK_DOMAINS_TREASURY_CONTRACT_ID=<0x-treasury-contract-id>
VITE_DUSK_DOMAINS_MARKETPLACE_CONTRACT_ID=<0x-marketplace-contract-id>
VITE_DUSK_DOMAINS_ROUTER_DRIVER_URL=/contracts/deployments/<router-hash>/dusk-domains-router.data-driver.wasm
VITE_DUSK_DOMAINS_CORE_DRIVER_URL=/contracts/deployments/<core-hash>/dusk-domains-core.data-driver.wasm
VITE_DUSK_DOMAINS_TREASURY_DRIVER_URL=/contracts/deployments/<treasury-hash>/dusk-domains-treasury.data-driver.wasm
VITE_DUSK_DOMAINS_MARKETPLACE_DRIVER_URL=/contracts/deployments/<marketplace-hash>/dusk-domains-marketplace.data-driver.wasm

VITE_DUSK_DOMAINS_ENABLE_LIVE_WRITES=true
VITE_DUSK_DOMAINS_ENABLE_REFERRAL_ATTRIBUTION=true
VITE_DUSK_DOMAINS_ENABLE_REFERRAL_CLAIMS=true
VITE_DUSK_DOMAINS_ENABLE_MARKETPLACE=true
VITE_DUSK_DOMAINS_ENABLE_LOCAL_DEV_WALLET=false

VITE_DUSK_DOMAINS_SUPPORT_URL=https://github.com/HDauven/dusk-domains-frontend/issues/new?template=support-request.yml
VITE_DUSK_DOMAINS_ABUSE_URL=https://github.com/HDauven/dusk-domains-frontend/issues/new?template=abuse-report.yml
VITE_DUSK_DOMAINS_SECURITY_URL=https://github.com/HDauven/dusk-domains-frontend/security/advisories/new
VITE_DUSK_DOMAINS_STATUS_URL=
