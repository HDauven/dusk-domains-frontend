# Copy to .env.testnet.local and replace the contract and driver placeholders.
VITE_DUSK_DOMAINS_CHAIN_ID=dusk:2
VITE_DUSK_DOMAINS_NODE_URL=https://testnet.nodes.dusk.network
VITE_DUSK_DOMAINS_INDEXER_URL=/api
VITE_DUSK_DOMAINS_SITE_URL=https://testnet.dusk.domains
VITE_DUSK_DOMAINS_OTHER_NETWORK_URL=https://dusk.domains
VITE_DUSK_DOMAINS_NOINDEX=true

# Copy these six role IDs and immutable URLs from the deploy bundle's frontend.env.
VITE_DUSK_DOMAINS_DIRECTORY_CONTRACT_ID=<0x-directory-contract-id>
VITE_DUSK_DOMAINS_POLICY_CONTRACT_ID=<0x-policy-contract-id>
VITE_DUSK_DOMAINS_STORE_CONTRACT_ID=<0x-store-contract-id>
VITE_DUSK_DOMAINS_VAULT_CONTRACT_ID=<0x-vault-contract-id>
VITE_DUSK_DOMAINS_RESOLVER_CONTRACT_ID=<0x-resolver-contract-id>
VITE_DUSK_DOMAINS_MARKETPLACE_CONTRACT_ID=<0x-marketplace-contract-id>
VITE_DUSK_DOMAINS_DIRECTORY_DRIVER_URL=/contracts/dusk-domains-directory.<sha256>.data-driver.wasm
VITE_DUSK_DOMAINS_POLICY_DRIVER_URL=/contracts/dusk-domains-policy.<sha256>.data-driver.wasm
VITE_DUSK_DOMAINS_STORE_DRIVER_URL=/contracts/dusk-domains-store.<sha256>.data-driver.wasm
VITE_DUSK_DOMAINS_VAULT_DRIVER_URL=/contracts/dusk-domains-vault.<sha256>.data-driver.wasm
VITE_DUSK_DOMAINS_RESOLVER_DRIVER_URL=/contracts/dusk-domains-resolver.<sha256>.data-driver.wasm
VITE_DUSK_DOMAINS_MARKETPLACE_DRIVER_URL=/contracts/dusk-domains-marketplace.<sha256>.data-driver.wasm
# Optional reviewed manifest listing every admitted implementation, including moved shards.
# VITE_DUSK_DOMAINS_MANIFEST_URL=/manifest.json

VITE_DUSK_DOMAINS_ENABLE_LIVE_WRITES=true
VITE_DUSK_DOMAINS_ENABLE_REFERRAL_ATTRIBUTION=true
VITE_DUSK_DOMAINS_ENABLE_REFERRAL_CLAIMS=true
VITE_DUSK_DOMAINS_ENABLE_MARKETPLACE=true
VITE_DUSK_DOMAINS_ENABLE_LOCAL_DEV_WALLET=false

VITE_DUSK_DOMAINS_SUPPORT_URL=https://github.com/HDauven/dusk-domains-frontend/issues/new?template=support-request.yml
VITE_DUSK_DOMAINS_ABUSE_URL=https://github.com/HDauven/dusk-domains-frontend/issues/new?template=abuse-report.yml
VITE_DUSK_DOMAINS_SECURITY_URL=https://github.com/HDauven/dusk-domains-frontend/security/advisories/new
VITE_DUSK_DOMAINS_STATUS_URL=
